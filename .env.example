VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# DeepSeek API - 生产环境
VITE_DEEPSEEK_API_KEY=sk-your-production-key

# DeepSeek API - 开发环境（可选，独立配额）
VITE_DEEPSEEK_API_KEY_DEV=sk-your-development-key

# DeepSeek API - 预发环境（可选）
VITE_DEEPSEEK_API_KEY_STG=sk-your-staging-key

# 当前环境标识: development | staging | production
VITE_APP_ENV=development
